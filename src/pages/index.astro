---
const nombre = "Sergio Valderrama";
const videoId = "-41RflONogo";
const githubUrl = "https://github.com/SergioV645";
const linkedinUrl = "https://www.linkedin.com/in/sergioavalderramav";
const email = "sergioavalderramav645@gmail.com";
const efsetUrl = "https://cert.efset.org/en/Hi6XQt";
const evidenceFolderUrl =
  "https://github.com/SergioV645/Portfolio/tree/main/public/proyectos";
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const avatarUrl = `${baseUrl}images/sergio.jpg`;
const projects = [
  {
    number: "01",
    title: "SQL & Bases de Datos",
    description:
      "Ejercicios y prácticas de realimentación.",
    tags: ["SQL", "Oracle", "Views"],
    file: `${baseUrl}proyectos/practica-sql-oracle.sql`,
  },
  {
    number: "02",
    title: "Consultas sobre HR",
    description:
      "Pruebas de consultas sobre el esquema HR del profesor.",
    tags: ["Oracle", "Queries", "HR Schema"],
    file: `${baseUrl}proyectos/consultas-hr.sql`,
  },
  {
    number: "03",
    title: "Portafolio Web",
    description:
      "Este sitio personal, construido con Astro, reúne mi presentación, proyectos, evidencias académicas y formas de contacto.",
    tags: ["Astro", "HTML", "CSS"],
    file: null,
  },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Portafolio profesional de Sergio Valderrama, estudiante de Ingeniería de Sistemas."
    />
    <meta name="theme-color" content="#080b12" />
    <title>{nombre} — Portafolio</title>
  </head>

  <body>
    <div class="background-grid" aria-hidden="true"></div>

    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Ir al inicio">SV<span>.</span></a>
      <nav aria-label="Navegación principal">
        <a href="#sobre-mi">Sobre mí</a>
        <a href="#presentacion">Presentación</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <a class="header-link" href={linkedinUrl} target="_blank" rel="noreferrer">LinkedIn ↗</a>
    </header>

    <main>
      <section class="hero" id="inicio">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Portafolio personal</p>
          <h1>Hola, soy <strong>Sergio</strong><br />Valderrama.</h1>
          <p class="hero-description">
            Estudiante de Ingeniería de Sistemas interesado en la tecnología,
            el desarrollo de soluciones y las bases de datos.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#proyectos">Ver proyectos <span>↓</span></a>
            <a class="button button-secondary" href={email}>Contactarme <span>↗</span></a>
          </div>
          <div class="hero-meta">
            <span><i></i> Universidad El Bosque</span>
          </div>
        </div>

        <div class="hero-visual">
          <div class="portrait-frame">
            <div class="portrait-glow"></div>
            <img src={avatarUrl} alt="Sergio Valderrama" />
            <div class="portrait-label">
              <span>SV</span>
              <small>Portfolio · 2026</small>
            </div>
          </div>
          <div class="floating-card">
            <span class="status-dot"></span>
            <div>
              <strong>Construyendo</strong>
              <small>aprendiendo constantemente</small>
            </div>
          </div>
        </div>
      </section>

      <section class="about section" id="sobre-mi">
        <div class="section-heading">
          <p class="eyebrow"><span></span> 01 — Sobre mí</p>
          <h2>Conocer el proceso<br /><em>Más sobre mí.</em></h2>
        </div>

        <div class="about-content">
          <div class="about-intro">
            <p class="lead">
              Soy Sergio Valderrama, estudiante de Ingeniería de Sistemas con
              interés en el desarrollo de soluciones tecnológicas y especialmente
              en el trabajo con bases de datos.
            </p>
          </div>
          <div class="about-text">
            <p>
              A lo largo de mi formación académica he trabajado con diferentes
              tecnologías y herramientas, desarrollando proyectos que me han
              permitido fortalecer mis conocimientos en bases de datos, SQL y
              desarrollo de software.
            </p>
            <p>
              Me considero una persona curiosa, responsable y con disposición para
              aprender constantemente. Disfruto enfrentar problemas, explorar
              diferentes formas de resolverlos y convertir lo aprendido en proyectos
              concretos.
            </p>
            <p>
              Este portafolio reúne parte de ese proceso: proyectos, evidencias y
              aprendizajes que representan mi evolución como estudiante y mi interés
              por seguir creciendo en el área de tecnología.
            </p>
          </div>
        </div>
      </section>

      <section class="presentation section" id="presentacion">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow"><span></span> 02 — Presentación</p>
            <h2>Una pequeña<br /><em>introducción.</em></h2>
          </div>
          <p class="section-note">Conoce mi presentación en video y parte personal de mí.</p>
        </div>

        <div class="video-card">
          <div class="video-wrapper">
            <iframe
              src={`https://www.youtube.com/embed/${videoId}`}
              title="Video de presentación de Sergio Valderrama"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </section>

      <section class="projects section" id="proyectos">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow"><span></span> 03 — Proyectos</p>
            <h2>Trabajo que<br /><em>he concretado este semestre.</em></h2>
          </div>
          <p class="section-note">
            Una selección de trabajos y prácticas desarrolladas durante mi formación.
          </p>
        </div>

        <div class="project-list">
          {projects.map((project) => {
            const CardTag = project.file ? "a" : "div";
            const cardProps = project.file
              ? { href: project.file, target: "_blank", rel: "noopener noreferrer" }
              : {};
            return (
              <CardTag class="project-card" {...cardProps}>
                <div class="project-number">{project.number}</div>
                <div class="project-main">
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <div class="tags">
                    {project.tags.map((tag) => <span>{tag}</span>)}
                  </div>
                </div>
                {project.file && <span class="project-arrow">↗</span>}
              </CardTag>
            );
          })}
        </div>

        <a
          class="evidence-banner"
          href={evidenceFolderUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <div>
            <p class="eyebrow"><span></span> Evidencias académicas</p>
            <h3>Ver todas mis evidencias en GitHub.</h3>
            <p>
              Carpeta con ejercicios, scripts y evidencias que se irá
              actualizando a medida que avance en mi formación.
            </p>
          </div>
          <span class="banner-mark">+</span>
        </a>
      </section>

      <section class="contact section" id="contacto">
        <div class="contact-inner">
          <div>
            <p class="eyebrow"><span></span> 04 — Contacto</p>
            <h2>Contactame<br /><em>Algunas de mis redes</em></h2>
            <p class="contact-description">
              Si quieres conocer más sobre mi trabajo, proyectos o trayectoria,
              puedes encontrarme en estos canales. Asi mismo, mi certificado
              en la segunda lengua.
            </p>
          </div>

          <div class="contact-links">
            <a href={`mailto:${email}`} class="contact-link">
              <span class="contact-icon">@</span>
              <span><small>Email</small><strong>{email}</strong></span>
              <b>↗</b>
            </a>
            <a href={linkedinUrl} target="_blank" rel="noreferrer" class="contact-link">
              <span class="contact-icon">in</span>
              <span><small>LinkedIn</small><strong>/sergioavalderramav</strong></span>
              <b>↗</b>
            </a>
            <a href={githubUrl} target="_blank" rel="noreferrer" class="contact-link">
              <span class="contact-icon">⌘</span>
              <span><small>GitHub</small><strong>SergioV645</strong></span>
              <b>↗</b>
            </a>
            <a href={efsetUrl} target="_blank" rel="noreferrer" class="contact-link">
              <span class="contact-icon">EN</span>
              <span><small>Certificado de inglés</small><strong>EF SET · Ver certificado</strong></span>
              <b>↗</b>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div><strong>SV<span>.</span></strong> — Sergio Valderrama</div>
      <span>Diseñado y desarrollado con Astro · {new Date().getFullYear()}</span>
      <a href="#inicio">Volver arriba ↑</a>
    </footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');

  :root {
    --bg: #080b12;
    --surface: #10151f;
    --surface-2: #151b27;
    --line: rgba(255, 255, 255, 0.09);
    --text: #f4f6f8;
    --muted: #8d97a7;
    --accent: #7c8cff;
    --accent-soft: rgba(124, 140, 255, 0.12);
    --max: 1180px;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    color: var(--text);
    background: var(--bg);
    font-family: 'Manrope', system-ui, sans-serif;
    line-height: 1.65;
    overflow-x: hidden;
  }
  a { color: inherit; }
  .background-grid {
    position: fixed;
    inset: 0;
    z-index: -2;
    opacity: 0.5;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, black, transparent 80%);
  }
  .background-grid::after {
    content: '';
    position: absolute;
    width: 700px;
    height: 700px;
    top: -300px;
    right: -220px;
    border-radius: 50%;
    background: var(--accent-soft);
    filter: blur(100px);
  }

  .site-header {
    width: min(calc(100% - 48px), var(--max));
    margin: 0 auto;
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }
  .brand { font-size: 1.25rem; font-weight: 800; text-decoration: none; letter-spacing: -0.06em; }
  .brand span, .site-footer span { color: var(--accent); }
  nav { display: flex; gap: 34px; }
  nav a, .header-link, .site-footer a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.78rem;
    transition: color .2s ease;
  }
  nav a:hover, .header-link:hover, .site-footer a:hover { color: var(--text); }
  .header-link { color: var(--text); font-weight: 600; }

  main { width: min(calc(100% - 48px), var(--max)); margin: 0 auto; }
  .hero {
    min-height: 680px;
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 70px;
    align-items: center;
    padding: 92px 0 110px;
  }
  .eyebrow {
    margin: 0 0 18px;
    color: var(--muted);
    font-family: 'DM Mono', monospace;
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .14em;
  }
  .eyebrow span {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 18px var(--accent);
  }
  h1, h2, h3, p { margin-top: 0; }
  h1 {
    max-width: 800px;
    margin-bottom: 25px;
    font-size: clamp(3.6rem, 7vw, 6.6rem);
    line-height: .98;
    letter-spacing: -.075em;
    font-weight: 500;
  }
  h1 strong { font-weight: 800; }
  .hero-description { max-width: 560px; color: var(--muted); font-size: 1.02rem; }
  .hero-actions { display: flex; gap: 12px; margin: 34px 0 30px; }
  .button {
    display: inline-flex;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
    min-width: 145px;
    padding: 13px 16px;
    border-radius: 4px;
    font-size: .76rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform .2s ease, background .2s ease;
  }
  .button:hover { transform: translateY(-2px); }
  .button-primary { background: var(--text); color: #090c12; }
  .button-secondary { border: 1px solid var(--line); color: var(--text); }
  .hero-meta { display: flex; gap: 28px; color: var(--muted); font-family: 'DM Mono', monospace; font-size: .65rem; text-transform: uppercase; letter-spacing: .08em; }
  .hero-meta i { display: inline-block; width: 6px; height: 6px; margin-right: 7px; border-radius: 50%; background: #72d69a; }

  .hero-visual { position: relative; width: min(100%, 440px); justify-self: end; }
  .portrait-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .portrait-glow { position: absolute; width: 250px; height: 250px; top: -80px; right: -50px; background: var(--accent-soft); filter: blur(65px); }
  .portrait-frame img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; filter: saturate(.85); }
  .portrait-label { position: absolute; left: 20px; bottom: 20px; display: flex; align-items: baseline; gap: 12px; padding: 10px 13px; background: rgba(8,11,18,.8); backdrop-filter: blur(12px); border: 1px solid var(--line); }
  .portrait-label span { font-weight: 800; }
  .portrait-label small { color: var(--muted); font-family: 'DM Mono', monospace; font-size: .58rem; }
  .floating-card { position: absolute; right: -45px; bottom: 38px; display: flex; gap: 10px; align-items: center; padding: 13px 16px; background: var(--surface-2); border: 1px solid var(--line); box-shadow: 0 20px 60px rgba(0,0,0,.3); }
  .floating-card strong, .floating-card small { display: block; }
  .floating-card strong { font-size: .72rem; }
  .floating-card small { color: var(--muted); font-size: .58rem; }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #72d69a; box-shadow: 0 0 14px #72d69a; }

  .section { padding: 120px 0; border-top: 1px solid var(--line); }
  .section-heading h2 { margin-bottom: 0; font-size: clamp(2.4rem, 4vw, 4rem); line-height: 1.03; letter-spacing: -.065em; font-weight: 500; }
  h2 em { color: var(--muted); font-style: normal; }
  .split-heading { display: flex; justify-content: space-between; align-items: end; gap: 60px; margin-bottom: 55px; }
  .section-note { max-width: 300px; margin: 0 0 4px; color: var(--muted); font-size: .84rem; }

  .about-content { display: grid; grid-template-columns: 1fr 1fr; gap: 100px; margin-top: 70px; }
  .lead { font-size: 1.45rem; line-height: 1.45; letter-spacing: -.025em; }
  .about-text { color: var(--muted); font-size: .9rem; }
  .about-text p + p { margin-top: 20px; }

  .video-card { padding: 8px; border: 1px solid var(--line); background: var(--surface); }
  .video-wrapper { position: relative; padding-top: 56.25%; overflow: hidden; background: #000; }
  .video-wrapper iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .project-list { border-top: 1px solid var(--line); }
  .project-card { display: grid; grid-template-columns: 90px 1fr 40px; gap: 30px; align-items: start; padding: 35px 0; border-bottom: 1px solid var(--line); transition: padding .25s ease, background .25s ease; color: inherit; text-decoration: none; }
  a.project-card { cursor: pointer; }
  .project-card:hover { padding-left: 14px; padding-right: 14px; background: rgba(255,255,255,.018); }
  .project-number { color: var(--accent); font-family: 'DM Mono', monospace; font-size: .7rem; }
  .project-main h3 { margin-bottom: 9px; font-size: 1.35rem; letter-spacing: -.035em; }
  .project-main p { max-width: 660px; margin-bottom: 16px; color: var(--muted); font-size: .82rem; }
  .tags { display: flex; gap: 7px; flex-wrap: wrap; }
  .tags span { padding: 5px 9px; border: 1px solid var(--line); color: var(--muted); font-family: 'DM Mono', monospace; font-size: .57rem; }
  .project-arrow { color: var(--muted); font-size: 1.1rem; transition: color .2s ease; }
  .project-card:hover .project-arrow { color: var(--text); }
  .evidence-banner { display: flex; justify-content: space-between; align-items: end; margin-top: 60px; padding: 32px; border: 1px solid var(--line); background: linear-gradient(120deg, var(--surface), rgba(124,140,255,.05)); color: inherit; text-decoration: none; cursor: pointer; transition: border-color .2s ease, background .2s ease; }
  .evidence-banner:hover { border-color: var(--accent); }
  .evidence-banner h3 { margin-bottom: 5px; font-size: 1.3rem; }
  .evidence-banner p:last-child { max-width: 570px; margin: 0; color: var(--muted); font-size: .78rem; }
  .banner-mark { color: var(--accent); font-size: 3rem; font-weight: 200; line-height: 1; }

  .contact { padding-bottom: 90px; }
  .contact-inner { display: grid; grid-template-columns: .9fr 1.1fr; gap: 100px; }
  .contact h2 { margin-bottom: 25px; font-size: clamp(2.8rem, 5vw, 4.7rem); line-height: 1; letter-spacing: -.07em; font-weight: 500; }
  .contact-description { max-width: 400px; color: var(--muted); font-size: .85rem; }
  .contact-links { border-top: 1px solid var(--line); }
  .contact-link { display: grid; grid-template-columns: 42px 1fr 20px; align-items: center; gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .contact-icon { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--line); color: var(--muted); font-family: 'DM Mono', monospace; font-size: .62rem; }
  .contact-link small, .contact-link strong { display: block; }
  .contact-link small { margin-bottom: 3px; color: var(--muted); font-size: .6rem; text-transform: uppercase; letter-spacing: .08em; }
  .contact-link strong { font-size: .78rem; font-weight: 600; }
  .contact-link b { color: var(--muted); font-weight: 400; transition: color .2s ease, transform .2s ease; }
  .contact-link:hover b { color: var(--text); transform: translate(2px,-2px); }

  .site-footer { width: min(calc(100% - 48px), var(--max)); margin: 0 auto; padding: 28px 0 45px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 20px; color: var(--muted); font-family: 'DM Mono', monospace; font-size: .58rem; }
  .site-footer strong { color: var(--text); font-family: 'Manrope', sans-serif; font-size: .8rem; }

  @media (max-width: 850px) {
    .site-header nav { display: none; }
    .hero { grid-template-columns: 1fr; padding-top: 70px; }
    .hero-visual { justify-self: start; max-width: 390px; }
    .floating-card { right: -15px; }
    .about-content, .contact-inner { grid-template-columns: 1fr; gap: 45px; }
    .split-heading { align-items: start; flex-direction: column; gap: 20px; }
    .section-note { max-width: 480px; }
  }
  @media (max-width: 560px) {
    .site-header, main, .site-footer { width: min(calc(100% - 32px), var(--max)); }
    .site-header { height: 70px; }
    .header-link { font-size: .68rem; }
    .hero { min-height: auto; padding: 70px 0 90px; }
    h1 { font-size: clamp(3.1rem, 16vw, 4.7rem); }
    .hero-actions { flex-wrap: wrap; }
    .hero-meta { flex-direction: column; gap: 7px; }
    .section { padding: 85px 0; }
    .about-content { margin-top: 45px; }
    .project-card { grid-template-columns: 38px 1fr; gap: 14px; }
    .project-arrow { display: none; }
    .evidence-banner { padding: 24px; }
    .site-footer { flex-direction: column; }
  }
</style>
